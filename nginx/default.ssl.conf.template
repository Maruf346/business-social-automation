upstream tattoo_hysteria_backend {
    server backend:8007;
}

server {
    listen 80;
    server_name api.tattoohysteria.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.tattoohysteria.com;

    ssl_certificate /etc/letsencrypt/live/api.tattoohysteria.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.tattoohysteria.com/privkey.pem;

    client_max_body_size 200m;

    proxy_connect_timeout 60s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;

    location / {
        proxy_pass http://tattoo_hysteria_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;
    }
}
