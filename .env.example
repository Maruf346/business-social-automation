SECRET_KEY=secret_key_here
DEBUG=true
SERVE_MEDIA=true
ENABLE_BROWSABLE_API=False
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True
MEDIA_ROOT=./media
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# =================Orgin Allowed================================
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8007,http://127.0.0.1:8007

# =================Database / Redis================================
# Local docker compose can use POSTGRES_* automatically.
# Production can use either DATABASE_URL or POSTGRES_*.
POSTGRES_DB=tattoo_hysteria
POSTGRES_USER=tattoo_hysteria
POSTGRES_PASSWORD=change_me
# DATABASE_URL=postgres://tattoo_hysteria:change_me@db:5432/tattoo_hysteria
DATABASE_SSL_REQUIRE=False
DB_CONN_MAX_AGE=600
CELERY_BROKER_URL=redis://redis:6379/0

# =================API Extra Security================================
FRONTEND_APP_KEY=qe_frontend_2026_secret


# =================Meta WhatsApp Config================================
META_VERIFY_TOKEN=my_super_secret_token
META_APP_SECRET=
META_API_VERSION=v22.0


# =================AI Service Config================================
AI_API_URL=http://10.10.28.89:8001/api/v1/inquiries/analyze
AI_SUMMARY_API_URL=http://10.10.28.89:8001/api/v1/inquiries/telegram-summary
AI_API_TIMEOUT=30
AI_CHAT_HISTORY_LIMIT=20

TELEGRAM_BOT_TOKEN=some_telegram_bot_token
TELEGRAM_REVIEW_CHAT_ID=8145617629
# =================AI Service Config================================


# =================Media / Storage Config================================
MEDIA_BASE_URL=https://55k6tr24-8007.inc1.devtunnels.ms/media/
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_CUSTOM_DOMAIN=
AWS_LOCATION=media
AWS_QUERYSTRING_AUTH=False
AWS_DEFAULT_ACL=

# =================Docker Deploy================================
# Required on EC2 for docker-compose.prod.yml.
DOCKER_IMAGE=dockerhub_username/tattoo-hysteria-backend:latest
