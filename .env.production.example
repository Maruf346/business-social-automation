SECRET_KEY=generate_a_strong_secret
DEBUG=False
ALLOWED_HOSTS=YOUR_ELASTIC_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_ELASTIC_IP
SERVE_MEDIA=False
ENABLE_BROWSABLE_API=False

POSTGRES_DB=tattoo_hysteria
POSTGRES_USER=tattoo_hysteria
POSTGRES_PASSWORD=strong_postgres_password
DATABASE_URL=postgres://tattoo_hysteria:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/tattoo_hysteria
DATABASE_SSL_REQUIRE=True
DB_CONN_MAX_AGE=600

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True

DOCKER_IMAGE=yourdockerhubusername/tattoo-hysteria-backend:latest

USE_S3=True
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_STORAGE_BUCKET_NAME=tattoo-hysteria-media
AWS_S3_REGION_NAME=eu-central-1
AWS_LOCATION=media
AWS_QUERYSTRING_AUTH=False
AWS_DEFAULT_ACL=

AI_API_URL=http://tattoo_hysteria_ai:8001/api/v1/inquiries/analyze
AI_SUMMARY_API_URL=http://tattoo_hysteria_ai:8001/api/v1/inquiries/telegram-summary
AI_API_TIMEOUT=30
AI_CHAT_HISTORY_LIMIT=20

TELEGRAM_BOT_TOKEN=...
TELEGRAM_REVIEW_CHAT_ID=...

META_VERIFY_TOKEN=...
META_APP_SECRET=...
META_API_VERSION=v22.0
FRONTEND_APP_KEY=...